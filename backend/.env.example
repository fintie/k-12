APP_NAME=NextGenius K-12 Backend
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/nextgenius_k12
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
MEDIA_ROOT=media
MEDIA_URL=/media

# Learning Checkup AI provider priority:
# 1) LOCAL_LLM_PROVIDER=ollama
# 2) OPENAI_API_KEY
# 3) rule-based fallback
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma4
LOCAL_LLM_TIMEOUT_SECONDS=240
LOCAL_LLM_NUM_PREDICT=500

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Learning Checkup email delivery priority:
# 1) SMTP
# 2) Resend
# Set true if API submissions should fail without a mail provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=starttls
LEARNING_CHECKUP_FROM_EMAIL=
LEARNING_CHECKUP_REQUIRE_EMAIL_DELIVERY=false

RESEND_API_KEY=
